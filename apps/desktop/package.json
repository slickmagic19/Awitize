{
  "name": "awitize-desktop",
  "private": true,
  "version": "0.3.0",
  "description": "Awitize — ad-free YouTube Music desktop player with synced lyrics.",
  "author": "slickmagic19",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "dist:portable": "node ../../scripts/fetch-python.js && npm run build && electron-builder --win portable",
    "electron:dev": "electron ."
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "32.3.3",
    "electron-builder": "^25.0.0",
    "lucide-react": "^1.58.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "zustand": "^4.5.0"
  },
  "build": {
    "appId": "com.awitize.player",
    "productName": "Awitize",
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../services/music-api",
        "to": "music-api",
        "filter": [
          "main.py",
          "requirements.txt",
          "vendor/**"
        ]
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Awitize-${version}-win.${ext}"
    },
    "directories": {
      "output": "../../release"
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
